{
  "name": "typst-serverless",
  "version": "0.1.0",
  "description": "Containerized and serverless Typst compilation",
  "type": "module",
  "scripts": {
    "test": "node --test test/core/validate.test.js test/core/state.test.js test/core/assets.test.js",
    "test:core": "npm run test",
    "test:full": "docker run --rm --entrypoint node -v \"$(pwd):/project\" -w /project typst-serverless:test --test 'test/core/*.test.js'",
    "test:integration": "node --test test/integration/container.test.js test/integration/lambda.test.js test/integration/api.test.js",
    "test:lambda": "node --test test/integration/lambda.test.js",
    "compile": "node src/adapters/container/cli.js",
    "build:layer": "node scripts/build-typst-layer.js",
    "build:lambda": "node scripts/build-lambda-package.js",
    "deploy:lambda": "cd src/adapters/lambda-layer/pulumi && pulumi up"
  },
  "keywords": ["typst", "docker", "serverless", "pdf"],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  }
}
