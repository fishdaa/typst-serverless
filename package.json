{
  "name": "typst-serverless",
  "version": "0.1.7",
  "description": "Containerized and serverless Typst compilation",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json",
    "test": "devbox run test",
    "test:keep-output": "env TYPST_TEST_KEEP_OUTPUT=1 devbox run test",
    "test:keep-output:core": "env TYPST_TEST_KEEP_OUTPUT=1 npx vitest run test/core/ test/integration/webhooks-batch.spec.ts",
    "test:watch": "vitest",
    "test:core": "vitest run test/core/",
    "test:full": "./scripts/test-full.sh",
    "test:integration": "vitest run test/integration/",
    "test:lambda": "vitest run test/integration/lambda.spec",
    "test:localstack": "./scripts/test-localstack.sh",
    "compile": "node dist/adapters/container/cli.js",
    "build:layer": "node scripts/build-typst-layer.js",
    "build:layer:arm64": "LAMBDA_ARCH=arm64 node scripts/build-typst-layer.js",
    "build:lambda": "npm run build && node scripts/build-lambda-package.js",
    "lint": "eslint .",
    "deploy:lambda": "cd src/adapters/lambda-layer/pulumi && pulumi up",
    "deploy:tui": "npm run build && node dist/scripts/deploy-tui.js",
    "deploy:ecr": "cd src/adapters/ecr/pulumi && npm install && pulumi up"
  },
  "keywords": [
    "typst",
    "docker",
    "serverless",
    "pdf"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "busboy": "^1.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "rollup": "^4.59.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
