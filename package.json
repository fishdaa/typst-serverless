{
  "name": "serverless-typst",
  "version": "0.1.0",
  "description": "Containerized and serverless Typst compilation",
  "type": "module",
  "scripts": {
    "test": "docker run --rm --entrypoint node -v \"$(pwd):/project\" -w /project serverless-typst --test \"test/core/*.test.js\"",
    "test:core": "npm run test",
    "test:integration": "node test/integration/container.test.js",
    "compile": "node src/adapters/container/cli.js"
  },
  "keywords": ["typst", "docker", "serverless", "pdf"],
  "license": "MIT"
}
